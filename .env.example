# MarketPulse AI & Campaign Studio - example environment file.
# Copy to .env (never commit .env). Leave provider=none to use Local Analysis Mode.

MARPULSE_AI_PROVIDER=none          # none | openai | gemini
OPENAI_API_KEY=sk-your-key-here    # only if provider=openai
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-key     # only if provider=gemini (GOOGLE_API_KEY also accepted)
GEMINI_MODEL=gemini-2.0-flash

MARPULSE_AI_TIMEOUT=60             # seconds per request
MARPULSE_AI_RETRIES=2              # bounded retries with backoff
